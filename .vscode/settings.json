{
  // Pylance: setting `exclude` at all overrides its automatic exclusion of
  // virtual environments, so .venv must stay listed explicitly.
  "python.analysis.exclude": [
    "**/.*",
    "**/.venv",
    "**/node_modules",
    "**/__pycache__",
    "**/build",
    "**/flutter_app",
    "**/data"
  ],

  // Report problems for open files only, instead of analysing the whole tree.
  "python.analysis.diagnosticMode": "openFilesOnly",

  // The file watcher is separate from Pylance; it needs its own exclusions or
  // VS Code still walks these trees on every change.
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/.dsh/**": true,
    "**/.git/objects/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/node_modules/**": true,
    "**/flutter_app/build/**": true,
    "**/data/**": true
  },

  // Keeps generated bytecode out of the Explorer tree.
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true
  },

  // Keeps Ctrl+Shift+F out of 8GB of site-packages.
  "search.exclude": {
    "**/.venv": true,
    "**/.dsh": true,
    "**/flutter_app/build": true
  }
}
