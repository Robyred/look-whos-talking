# Environment
.env
.venv/
__pycache__/
*.pyc
*.pyo

# Data (large files — nothing in data/ should be committed)
data/

# Personal docs
Jack's documentation etc/
Jack's DeepSeek preferences.md

# Sandbox-local Flutter SDK + caches (not part of the repo)
.dsh/

# Editors
# Ignore .vscode contents by default, but share project-level config.
# NOTE: must be ".vscode/*", not ".vscode/" — git cannot re-include a file
# whose parent directory is excluded, so the negations below would not work.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/

# OS
.DS_Store
