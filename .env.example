# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Required. Read token for the gated pyannote diarisation model.
# The owning account must have accepted the conditions at
# https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_read_token_here

# Required by backend/insights.py (the /insights and /ask endpoints).
# Without it those endpoints raise ValueError at call time.
# The openai SDK is pointed at https://api.deepseek.com, model "deepseek-chat".
DEEPSEEK_API_KEY=your_deepseek_api_key_here
